{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourfeed",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": { "directory": "dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "yourfeed", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }],
  "vars": { "AUTH_MODE": "standalone" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
