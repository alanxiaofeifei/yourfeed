# Copy to .dev.vars for local use. Never commit the copy or real values.
# Deploy Button asks for these instance settings. Generate two DIFFERENT random keys.
APP_ENCRYPTION_KEY=
AUTH_SECRET=
OWNER_EMAIL=
AUTH_BASE_URL=

# Guided first deployment only. The deploy guard refuses a non-empty DB in initial mode.
# Cloudflare Account ID is account metadata, not an API token.
YOURFEED_DEPLOY_MODE=initial
CLOUDFLARE_ACCOUNT_ID=
# Existing instances: set YOURFEED_DEPLOY_MODE=release and provide a private manifest.
# YOURFEED_RELEASE_MANIFEST=/absolute/private/path/release.json
# See docs/deployment.md before running any remote migration.

# Optional: configure at least ONE sign-in provider after deployment.
# Google/GitHub OAuth avoids needing an email delivery service.
# Instructions and costs: docs/authentication.md. These entries do not create OAuth apps.
# Set AUTH_BASE_URL to your actual origin; replace EXAMPLE in callback URLs below.
# Google: create an OAuth client of type Web application (not a YouTube API Key).
# JavaScript origin: https://EXAMPLE; redirect: https://EXAMPLE/api/auth/callback/google
# Save BOTH credentials as Cloudflare Secret bindings; never commit actual values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub OAuth App callback: https://EXAMPLE/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Facebook requires a release with explicit owner-account linking; never first-sign-up by email.
# See docs/authentication.md before enabling; callback: https://EXAMPLE/api/auth/callback/facebook
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# Apple login is not currently implemented; ordinary Apple accounts are not OAuth credentials.
# Optional email OTP; requires a verified sending domain and a mail provider account.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=
# Optional provider keys. These can instead be encrypted through the private settings UI.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GLM_API_KEY=
# YOUTUBE_API_KEY=

# Local development only, for AUTH_BASE_URL=http://localhost:5173:
# AUTH_ALLOW_INSECURE_LOCAL=true

# Invited hosting uses independent instances; see docs/hosting.md.
# HOSTING_MODE=hosted
# INSTANCE_ID=
# HOSTED_INSTANCE_TOKEN=
# HOSTED_CONTROL_SERVICE is a service binding, not a URL or user-entered API token.
# Never put operator AI/YouTube keys in a hosted instance.
